# ==============================================================================
# AIoT NIDS & IPS — Muhit O'zgaruvchilari (Environment Variables)
# Ushbu fayldan nusxa olib `.env` yarating: cp .env.example .env
# ==============================================================================

# 1. Telegram SOC Boti Sozlamalari
# BotFather orqali yaratilgan bot tokeni va admin Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Asosiy NIDS Server Sozlamalari
AIOT_HOST=127.0.0.1
AIOT_PORT=5000
AIOT_TOKEN=
AIOT_IFACE=

# 3. Anomaliya va Oqim Tahlili Chegaralari
AIOT_WINDOW=5
AIOT_THRESHOLD=0.91
AIOT_MIN_FLOWS=4
AIOT_SCAN_PORTS=20
AIOT_FLOOD_PPS=200
